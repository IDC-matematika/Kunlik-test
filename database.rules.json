{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "config": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "cooldownMin": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440" },
      "seeded": { ".validate": "newData.isBoolean()" },
      "$other": { ".validate": false }
    },

    "bank": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$qid": {
        ".validate": "newData.hasChildren(['q', 'options', 'correct', 'solution'])"
      }
    },

    "overrides": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "lb": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "daily": {
        "$date": {
          "$id": {
            ".write": "auth != null && newData.child('uid').val() === auth.uid && (!data.exists() || !data.child('uid').exists() || data.child('uid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['name', 'uid', 'correct']) && (!root.child('students').child(auth.uid).exists() || (newData.child('name').val() === root.child('students').child(auth.uid).child('name').val() && newData.child('cls').val() === root.child('students').child(auth.uid).child('cls').val()))",
            "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "uid": { ".validate": "newData.isString()" },
            "ts": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
            "correct": { ".validate": "newData.isNumber() && newData.val() >= 0 && ((!data.exists() && newData.val() <= 100) || (data.exists() && newData.val() <= data.val() + 100))" },
            "attempts": { ".validate": "newData.isNumber() && newData.val() >= 0 && ((!data.exists() && newData.val() <= 1) || (data.exists() && newData.val() <= data.val() + 1))" },
            "cls": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "$other": { ".validate": false }
          }
        }
      },
      "weekly": {
        "$week": {
          "$id": {
            ".write": "auth != null && newData.child('uid').val() === auth.uid && (!data.exists() || !data.child('uid').exists() || data.child('uid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['name', 'uid', 'correct']) && (!root.child('students').child(auth.uid).exists() || (newData.child('name').val() === root.child('students').child(auth.uid).child('name').val() && newData.child('cls').val() === root.child('students').child(auth.uid).child('cls').val()))",
            "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "uid": { ".validate": "newData.isString()" },
            "ts": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
            "correct": { ".validate": "newData.isNumber() && newData.val() >= 0 && ((!data.exists() && newData.val() <= 100) || (data.exists() && newData.val() <= data.val() + 100))" },
            "cls": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },

    "classes": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$cid": {
        ".validate": "newData.hasChildren(['name'])",
        "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "students": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'cls', 'login'])",
        "name": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40" },
        "cls": { ".validate": "newData.isString() && newData.val().length <= 20 && newData.val().matches(/^(5|6|7|8|9|10|11)(-.+)?$/)" },
        "login": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 40" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "active": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    },

    "studentSecrets": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "results": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$rid": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.hasChildren(['name', 'cls', 'date', 'ts', 'score', 'total', 'mode']) && (!root.child('students').child($uid).exists() || (newData.child('name').val() === root.child('students').child($uid).child('name').val() && newData.child('cls').val() === root.child('students').child($uid).child('cls').val()))",
          "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "cls": { ".validate": "newData.isString() && newData.val().length <= 20 && newData.val().matches(/^(5|6|7|8|9|10|11)(-.+)?$/)" },
          "pid": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "date": { ".validate": "newData.isString() && newData.val().length === 10" },
          "ts": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
          "score": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().child('total').val()" },
          "total": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100" },
          "elapsed": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "mode": { ".validate": "newData.isString() && newData.val().matches(/^(solo|mistakes|adaptive|live)$/)" },
          "room": { ".validate": "newData.isString() && newData.val().length <= 10" },
          "topics": {
            "$t": {
              "c": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "t": { ".validate": "newData.isNumber() && newData.val() >= 1" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        }
      }
    },

    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || (data.exists() && data.child('ownerUid').val() === auth.uid) || root.child('admins').child(auth.uid).val() === true)",
        "students": {
          "$sid": {
            ".write": "auth != null && auth.uid === $sid && root.child('rooms').child($code).exists()",
            ".validate": "newData.hasChildren(['name', 'cls'])",
            "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "finishedAt": { ".validate": "newData.isNumber()" },
            "score": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
            "done": { ".validate": "newData.isBoolean()" },
            "cls": { ".validate": "newData.isString() && newData.val().length <= 20 && newData.val().matches(/^(5|6|7|8|9|10|11)(-.+)?$/)" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
